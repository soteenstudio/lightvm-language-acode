{
  "name": "acode-plugin",
  "version": "1.0.0",
  "description": "TypeScript template for Acode plugins",
  "main": "dist/main.js",
  "repository": "https://github.com/Acode-Foundation/AcodeTSTemplate.git",
  "author": "Acode Foundation",
  "license": "MIT",
  "dependencies": {
    "@lezer/lr": "^1.4.10",
    "acode-plugin-types": "^1.12.9",
    "html-tag-js": "^2.4.15"
  },
  "devDependencies": {
    "@lezer/generator": "^1.8.0",
    "esbuild": "^0.27.2",
    "jszip": "^3.10.1",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs --serve",
    "generate:parser": "lezer-generator src/lightvm.grammar --output src/lightvm-parser.ts --typeScript",
    "prebuild": "npm run generate:parser",
    "build": "tsc --noEmit && node esbuild.config.mjs",
    "pretypecheck": "npm run generate:parser",
    "typecheck": "tsc --noEmit"
  },
  "browserslist": "cover 100%,not android < 5"
}
